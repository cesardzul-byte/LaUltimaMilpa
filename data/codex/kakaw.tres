[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"kakaw"
term = "kakaw"
pronunciation = "ka-káu"
meaning = "Cacao (Theobroma cacao), semilla que servía de moneda en Yucatán antes de la Conquista. Landa cuenta que los mercaderes llevaban sal y ropa a Tabasco y Ulúa y lo cambiaban todo por kakaw y cuentas de piedra, que eran su moneda; también usaban conchas coloradas. En los mercados fiaban, prestaban y pagaban sin usura. Del maíz y el kakaw molidos hacían una bebida espumosa para sus fiestas, y quienes tenían árboles de kakaw les hacían una fiesta a Cháak y a otros dioses protectores."
in_game_use = "Moneda del mercado de la plaza. Se gana vendiendo cosechas y plumas y al derrotar wáay; se gasta en semillas, saka' y copal, en antorchas de copal y en reparar albarradas. La ofrenda del templo pide 30 cacaos."
sources = PackedStringArray("CORDEMEX", "LANDA")
