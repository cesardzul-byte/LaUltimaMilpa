[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"kakaw"
term = "kakaw"
pronunciation = "ka-káu"
meaning = "Cacao (Theobroma cacao), grano sagrado y moneda de cambio en Mesoamérica prehispánica. En el kool no crece (clima seco), pero llega por trueque desde el sur. No existía moneda acuñada; el kakaw se usaba junto con cuentas de piedra, mantas y cobre como medios de valor. Los granos se contaban en cargas de 24 000 (xiquipil) para tributos y comercio de larga distancia."
in_game_use = "Moneda del mercado regional; se gana vendiendo cosechas y matando wáay; se gasta en semillas, saka', pom, reparar albarradas y antorchas de copal."
sources = PackedStringArray("CORDEMEX", "LANDA")