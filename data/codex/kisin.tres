[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"kisin"
term = "Kisin"
pronunciation = "ki-sín"
meaning = "Señor de Metnal, el inframundo maya yucateco (Landa lo escribe Mitnal). Kisin gobierna a los muertos y preside los temblores de tierra. Su nombre significa «el hediondo» o «el flatulento», epíteto de su naturaleza putrefacta. En la cerámica y los códices aparece como esqueleto danzante con collar de ojos. Metnal es el inframundo yucateco, distinto del inframundo k'iche' de Guatemala."
in_game_use = "Señor de Metnal que envía oleadas de wáay cada noche; se nombra en la intro y en textos de lore."
sources = PackedStringArray("CORDEMEX", "THOMPSON1970", "LANDA")