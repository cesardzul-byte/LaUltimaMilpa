[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"cha_chaak"
term = "Ch'a' Cháak"
pronunciation = "ch'a' cháak"
meaning = "Ceremonia campesina de petición de lluvia ('traer la lluvia'). Se invoca a los cuatro Cháak, señores de la lluvia en cada rumbo: oriente (lak'in, rojo), norte (xaman, blanco), poniente (chik'in, negro) y sur (nojol, amarillo). Los h-men (sacerdotes) y la comunidad baten el tunk'ul, queman pom y ofrecen saka' para que envíen agua al kool. Landa registra los nombres coloniales: Chac Xib Chac, Sac Xib Chac, Ek Xib Chac y Kan Xib Chac."
in_game_use = "Ritual final del nivel 1 (minijuego de ritmo); completarlo muestra la llegada de la lluvia y lleva a la pantalla de fin."
sources = PackedStringArray("LANDA", "CORDEMEX", "BRICKER1998", "REDFIELD1934", "TERAN1994")