[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"ixiim"
term = "ixi'im"
pronunciation = "i-shi-'im"
meaning = "Granos de maíz, base de la alimentación y la cosmogonía maya yucateca. En el kool, el ixi'im crece entrelazado con bu'ul (frijol) y k'úum (calabaza) en un policultivo milenario: el frijol fija nitrógeno y la calabaza cubre el suelo reteniendo humedad. La primera cosecha se ofrenda a los aluxes y a Cháak antes de consumir, según la tradición agrícola de la península."
in_game_use = "Cultivo principal del kool; se entrega en ofrenda de saka', alimenta pavos y se vende por cacao en el mercado regional."
sources = PackedStringArray("CORDEMEX", "BRICKER1998", "TERAN1994", "REDFIELD1934")