[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"tsiibil_chaaltun"
term = "Ts'íibil Cháaltun"
pronunciation = "ts'íi-bil cháal-tun"
meaning = "Ts'íibil Cháaltun («donde hay escritura en piedras planas»), nombre maya de Dzibilchaltún (nombre oficial INAH). Fue ciudad importante desde el Preclásico medio (ca. 500 a. C.) hasta la Conquista; destaca el Templo de las Siete Muñecas, alineado al equinoccio. Xlacah (en maya, Xlakaj), que el INAH traduce «pueblo viejo», es el cenote principal, fuente de agua dulce y ofrendas ceremoniales; en su fondo hallaron cerámica, jade y huesos."
in_game_use = "Sitio del nivel 1. En la Tarde, su mapa regional muestra tres lugares: el cenote Xlacah, la plaza (mercado) y el Templo de las Siete Muñecas (ofrenda)."
sources = PackedStringArray("ANDREWS1980", "INAH", "CORDEMEX")
