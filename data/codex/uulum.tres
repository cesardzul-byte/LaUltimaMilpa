[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"uulum"
term = "úulum"
pronunciation = "úu-lum"
meaning = "Pavo doméstico (Meleagris gallopavo domesticus), ave nativa de Mesoamérica domesticada antes de la Conquista. A diferencia de la gallina (llegada con los españoles), el úulum es parte de la milpa tradicional: come insectos, fertiliza el suelo y sus plumas se usan en rituales. En el corral del kool, los úulumo'ob ponen huevos y alertan de intrusos; si muere uno, el jugador pierde proteína y fertilizante. Existe variante silvestre: kuuts (pavo ocelado)."
in_game_use = "Pavos del corral; generan huevos y fertilizante; su muerte reduce recursos del kool."
sources = PackedStringArray("CORDEMEX", "BRICKER1998")