[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"uulum"
term = "úulum"
pronunciation = "úu-lum"
meaning = "Pavo doméstico (Meleagris gallopavo domesticus), ave nativa de Mesoamérica domesticada antes de la Conquista. El úulum es parte de la milpa tradicional: come insectos, fertiliza el suelo y sus plumas se usan en rituales y atavíos ceremoniales. Los huevos son alimento y ofrenda sagrada. Existe variante silvestre: kuuts (pavo ocelado, Meleagris ocellata), de plumaje más brillante y habitante del monte."
in_game_use = "Pavos del corral; al morir sueltan plumas de pavo; si se acaban los pavos, no hay más plumas."
sources = PackedStringArray("CORDEMEX", "BRICKER1998")