[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"kool"
term = "kool"
pronunciation = "kool"
meaning = "Terreno desmontado y quemado donde se siembra maíz, frijol y calabaza en policultivo; es la unidad básica de la agricultura maya yucateca. El kool no es solo un campo, sino un espacio ritualizado: su preparación implica pedir permiso a los dueños del monte, y su ciclo marca el calendario campesino. En Dzibilchaltún, los restos de albarradas (koot) delimitan kool'oob antiguos."
in_game_use = "Escenario principal del nivel 1; el jugador siembra, riega y defiende su kool durante cinco días."
sources = PackedStringArray("CORDEMEX", "TERAN1994", "BASTARRACHEA1992")