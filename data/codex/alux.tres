[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"alux"
term = "alux (pl. aluxo'ob)"
pronunciation = "a-lúsh"
meaning = "Seres pequeños que cuidan la milpa, el monte y el agua; viven en cuevas y cenotes. Si el campesino les deja ofrenda de saka' (bebida ceremonial de maíz) y pom (copal) en el altar, los aluxo'ob protegen los cultivos, espantan plagas y cuidan el agua. Si se les olvida o se les ofende, hacen travesuras: esconden herramientas, derriban albarradas o enferman los animales. En la tradición de Yucatán, son los verdaderos dueños de la tierra."
in_game_use = "Guardianes de la milpa; reciben ofrenda de saka' en el altar para obtener bendición que acelera el crecimiento de cultivos."
sources = PackedStringArray("CORDEMEX", "REDFIELD1934")