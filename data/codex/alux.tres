[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"alux"
term = "alux (pl. aluxo'ob)"
pronunciation = "a-lúsh"
meaning = "Seres pequeños del monte: miden como un pie de alto y parecen niños, pero con barba y una corona de barro. En Chan Kom se cree que viven en los montículos antiguos y en las figuras de barro que aparecen en el monte, y que salen de noche; por eso no se silba ni se grita al oscurecer. Son traviesos y se les teme, pero también cuidan la milpa: se les deja saka' para que no hagan daño, y se cuenta que la milpa que cuidan siempre está verde."
in_game_use = "Guardianes de la milpa; reciben ofrenda de saka' en el altar para obtener bendición que hace que las oleadas de wáay aparezcan más espaciadas."
sources = PackedStringArray("CORDEMEX", "REDFIELD1934")
