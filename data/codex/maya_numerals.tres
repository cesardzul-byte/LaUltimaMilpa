[gd_resource type="Resource" script_class="CodexEntryData" format=3]

[ext_resource type="Script" path="res://src/codex/codex_entry_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"maya_numerals"
term = "mix ba'al"
pronunciation = "mish ba-'al"
meaning = "Mix ba'al («nada») es el cero. Los numerales mayas forman un sistema vigesimal (base 20) con tres signos: concha (0), punto (1) y barra (5); del 1 al 19 se combinan puntos y barras. Al contar objetos se agrega el clasificador -p'éel (ej. jump'éel = una cosa). Los numerales aparecen en estelas, códices y en la cuenta del tiempo ritual. Landa registra que contaban de cinco en cinco hasta veinte, y después en grupos de veinte, de cuatrocientos y de ocho mil, y que esta cuenta servía mucho en el comercio del kakaw."
in_game_use = "Resumen del amanecer (día 1–5) y códice; se dibujan con concha, punto y barra."
sources = PackedStringArray("BASTARRACHEA1992", "BRICKER1998", "CORDEMEX", "LANDA")
